# Copie este arquivo para .env e preencha os valores.
# O .env NUNCA deve ser versionado (ja esta no .gitignore).

# Obrigatoria: sua chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Opcional: modelo Gemini usado pelos agentes
# (padrao: gemini-flash-lite-latest; qualquer modelo Gemini pode ser usado)
# AURORA_MODELO=gemini-flash-lite-latest

# Opcional: cadeia de modelos de reserva para falhas transitorias (429/503)
# AURORA_MODELOS_FALLBACK=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-flash-latest
